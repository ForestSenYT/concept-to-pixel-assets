  "face_box": "crop x0,y0,x1,y1 for face previews",
  "normals.rules": "colour -> part (first match wins, optional region); unmatched = outline",
  "normals.head": "parts that form the head sphere; above_part = the torso part where the head ends (follows breathing)",
  "cast": "other characters' front sprites for the scale check image",
  "unity": "C# class prefix, Tools menu name, pixels per unit"
